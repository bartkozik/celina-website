{
  "name": "@celina/wordpress-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.15.0"
  },
  "scripts": {
    "wp:start": "tsx scripts/wp/start.ts",
    "wp:content:start": "tsx scripts/wp/content-start.ts",
    "wp:stop": "wp-env stop",
    "dev": "wp-scripts start --webpack-copy-php --source-path=wordpress/plugins/celina-blocks/src --output-path=wordpress/plugins/celina-blocks/build",
    "build": "wp-scripts build --webpack-copy-php --source-path=wordpress/plugins/celina-blocks/src --output-path=wordpress/plugins/celina-blocks/build",
    "lint": "pnpm lint:js && pnpm lint:css",
    "lint:js": "wp-scripts lint-js \"scripts/**/*.ts\" \"tests/**/*.ts\" \"wordpress/themes/celina-child/assets/js/**/*.js\" \"wordpress/plugins/celina-blocks/src/**/*.ts\" \"wordpress/plugins/celina-blocks/src/**/*.tsx\"",
    "lint:css": "wp-scripts lint-style --allow-empty-input \"wordpress/themes/celina-child/**/*.css\" \"wordpress/plugins/celina-blocks/src/**/*.css\" \"wordpress/plugins/celina-blocks/src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "php:lint": "tsx scripts/check-php.ts",
    "test:fixtures": "tsx scripts/test-fixtures.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm php:lint && pnpm test:fixtures",
    "test:unit": "vitest run --exclude 'tests/e2e/**' --exclude 'tests/e2e-content/**' --exclude 'tests/e2e-hosted/**' --exclude 'ops/**'",
    "test:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/celina-blocks vendor/bin/phpunit -c phpunit.xml.dist",
    "test:content": "tsx scripts/content/integration.ts",
    "test:e2e": "tsx scripts/wp/e2e.ts",
    "test:e2e:content": "tsx scripts/content/e2e.ts",
    "content:plan": "tsx scripts/content/cli.ts plan",
    "content:apply": "tsx scripts/content/cli.ts apply",
    "block:create": "tsx scripts/block-create/cli.ts",
    "package": "tsx scripts/package/cli.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.17.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@wordpress/block-editor": "17.0.0",
    "@wordpress/blocks": "15.27.0",
    "@wordpress/components": "40.0.0",
    "@wordpress/core-data": "7.54.0",
    "@wordpress/data": "10.54.0",
    "@wordpress/element": "8.6.0",
    "@wordpress/env": "10.27.0",
    "@wordpress/i18n": "6.27.0",
    "@wordpress/scripts": "30.24.0",
    "fflate": "0.8.2",
    "jsdom": "29.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsx": "4.20.4",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  }
}
