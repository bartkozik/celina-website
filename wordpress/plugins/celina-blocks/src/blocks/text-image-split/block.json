{
  "apiVersion": 2,
  "name": "celina/text-image-split",
  "version": "0.1.0",
  "title": "Text + Image Split — REDESIGNED",
  "category": "celina-redesigned",
  "icon": "align-pull-left",
  "textdomain": "celina-blocks",
  "attributes": {
    "eyebrow": {
      "type": "string",
      "default": ""
    },
    "heading": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageUrl": {
      "type": "string",
      "default": ""
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "imageDecorative": {
      "type": "boolean",
      "default": false
    },
    "imagePosition": {
      "type": "string",
      "enum": ["left", "right"],
      "default": "right"
    },
    "background": {
      "type": "string",
      "enum": ["neutral", "warm"],
      "default": "neutral"
    },
    "buttonLabel": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "buttonNewTab": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "html": false,
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
